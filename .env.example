# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display / mailto contact address shown in the UI
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional scheduling link shown after successful contact submission
NEXT_PUBLIC_SCHEDULING_URL=

# Optional privacy-conscious analytics domain
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Server-only email delivery (never expose to the browser)
CONTACT_TO_EMAIL=hello@example.com
CONTACT_FROM_EMAIL=noreply@example.com
EMAIL_PROVIDER_API_KEY=
